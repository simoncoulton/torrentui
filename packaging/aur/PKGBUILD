# Maintainer: Simon Coulton <simon.coulton@gmail.com>
pkgname=torrentui
pkgver=0.1.0
pkgrel=1
pkgdesc='Terminal BitTorrent client with a background daemon, tags and post-download actions'
arch=('x86_64' 'aarch64')
url='https://github.com/simoncoulton/torrentui'
license=('MIT')
# Confirm with `namcap` / `ldd` after building; adjust if the binary links more.
depends=('gcc-libs')
makedepends=('cargo')
optdepends=('xdg-utils: register torrentui as the magnet link handler'
            'libnotify: desktop notifications')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')   # run `updpkgsums` once the v$pkgver tag exists

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/torrentui "$pkgdir/usr/bin/torrentui"
  # `systemctl --user enable --now torrentui` runs the daemon at login.
  install -Dm644 packaging/systemd/torrentui.service \
    "$pkgdir/usr/lib/systemd/user/torrentui.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
